{
  "expo": {
    "name": "Todo",
    "icon": "./assets/icon-cool.png",
    "slug": "todo-performance",
    "scheme": "todo-performance",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "web": {
      "favicon": "./assets/icon-cool.png"
    },
    "ios": {
      "bundleIdentifier": "com.nagaiasuka.todo",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "./plugins/with-adaptive-todo-widget",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.nagaiasuka.todo",
          "widgets": [
            {
              "name": "TodoHome",
              "displayName": "Todo / 優先タスク",
              "description": "4分類の優先順位で、未完了タスクを確認。",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "src/widgets/TodoHome.tsx"
              }
            },
            {
              "name": "TodoLock",
              "displayName": "Todo / 今日と次のタスク",
              "description": "表示する情報はアプリの設定で選べます。",
              "ios": {
                "supportedFamilies": [
                  "accessoryInline",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "initialLayout": "src/widgets/TodoLock.tsx"
              }
            }
          ],
          "bundleIdentifier": "com.nagaiasuka.todo.widgets"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.nagaiasuka.todo.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.nagaiasuka.todo"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6d5698e0-ab4b-4629-ba5d-932450d0b47e"
      }
    },
    "owner": "asukanagai"
  }
}
